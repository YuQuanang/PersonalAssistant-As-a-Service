# Copy this file to .env and fill in any overrides.
# All values below show the defaults — change only what you need.

# ── Orchestrator ─────────────────────────────────────────────────────
PORT=3000

# ── Ollama ───────────────────────────────────────────────────────────
# Make sure Ollama is running: ollama serve
# Pull the model first:        ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Max time (ms) to wait for the LLM to finish generating (default: 120s)
OLLAMA_TIMEOUT_MS=120000

# ── Downstream service URLs ───────────────────────────────────────────
CALENDAR_SERVICE_URL=http://localhost:3001
TASK_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_URL=http://localhost:3003

# ── Per-request timeout for service calls (ms) ───────────────────────
SERVICE_TIMEOUT_MS=5000
